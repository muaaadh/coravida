{
  "buildCommand": "node tools/vercel-build.js",
  "outputDirectory": "_site",
  "framework": null,
  "functions": {
    "api/page.js": {
      "maxDuration": 10,
      "includeFiles": "{tools/**,content/**,*.html,ru/**,zh/**,de/**,excursions/**}"
    },
    "api/publish.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(webp|mp4|mp3|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/media/(.*)",
      "destination": "https://hkzseexkxufrqbngzqdk.supabase.co/storage/v1/object/public/media/$1"
    },
    {
      "source": "/assets/js/data.js",
      "destination": "/api/page?p=assets/js/data.js"
    },
    {
      "source": "/assets/js/data.:lang.js",
      "destination": "/api/page?p=assets/js/data.:lang.js"
    },
    {
      "source": "/((?!api/|assets/|admin|content/|media/|robots\\.txt|sitemap\\.xml|favicon).*)",
      "destination": "/api/page?p=$1"
    }
  ]
}
